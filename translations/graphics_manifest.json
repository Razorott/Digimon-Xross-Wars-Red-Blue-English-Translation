  {
    "archive": "BG_NCGR.PAK + BG_NSCR.PAK",
    "entry": 33,
    "english": [
      "I'm Taiki Kudo!",
      "A middle school student",
      "from Koto, Tokyo."
    ]
  },
  {
    "archive": "BG_NCGR.PAK + BG_NSCR.PAK",
    "entry": 34,
    "english": [
      "One day, I heard a voice",
      "calling for help.",
      "Following that voice..."
    ]
  },
  {
    "archive": "BG_NCGR.PAK + BG_NSCR.PAK",
    "entry": 35,
    "english": [
      "My friends and I were",
      "sent to another world:",
      "the Digital World!"
    ]
  },
  {
    "archive": "BG_NCGR.PAK + BG_NSCR.PAK",
    "entry": 36,
    "english": [
      "There, we met creatures",
      "made of digital data,",
      "known as Digimon."
    ]
  },
  {
    "archive": "BG_NCGR.PAK + BG_NSCR.PAK",
    "entry": 37,
    "english": [
      "A hotheaded troublemaker",
      "who dreams of becoming",
      "the King of the Digimon:",
      "Shoutmon!"
    ]
  },
  {
    "archive": "BG_NCGR.PAK + BG_NSCR.PAK",
    "entry": 38,
    "english": [
      "A powerful fighter",
      "you can always count on:",
      "Ballistamon!"
    ]
  },
  {
    "archive": "BG_NCGR.PAK + BG_NSCR.PAK",
    "entry": 39,
    "english": [
      "A wandering spirit",
      "who loves his freedom:",
      "Dorulumon!"
    ]
  },
  {
    "archive": "BG_NCGR.PAK + BG_NSCR.PAK",
    "entry": 40,
    "english": [
      "In the Digital World,",
      "mighty Digimon we had",
      "never seen awaited us."
    ]
  },
  {
    "archive": "BG_NCGR.PAK + BG_NSCR.PAK",
    "entry": 41,
    "english": [
      "And now, our",
      "new adventure",
      "was about to begin..."
    ]
  },
  {
    "archive": "BG_NCGR.PAK + BG_NSCR.PAK",
    "entry": 23,
    "english": "DIGIMON XROS WARS"
  }
]
